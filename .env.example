# Copy to .env; use a unique local password. Never commit .env.
MONADEX_DB_PASSWORD=replace-with-a-unique-local-password
MONADEX_DB_PORT=5433
# Export separately for the Haskell process (Compose does not export this variable):
# DATABASE_URL=host=127.0.0.1 port=5433 user=monadex password=YOUR_PASSWORD dbname=monadex_db
# PORT=3000
# SESSION_KEY_PATH=.session-key
# SESSION_COOKIE_SECURE=true  # enable behind correctly configured HTTPS
# FRONTEND_ORIGIN=http://127.0.0.1:5173  # optional; match the API hostname for SameSite=Strict
# MONADEX_TEST_DATABASE_URL=host=127.0.0.1 port=5433 user=monadex password=YOUR_PASSWORD dbname=monadex_test_db
